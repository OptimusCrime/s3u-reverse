# Normalize all text files to LF in the repo and working tree,
# so macOS and Windows checkouts are identical.
* text=auto eol=lf

# Windows-only scripts need CRLF to run correctly
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never touch line endings or attempt diffs
*.exe  binary
*.dll  binary
*.bin  binary
*.dat  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.bmp  binary
*.ico  binary
*.wav  binary
*.mp3  binary
*.zip  binary
*.7z   binary
*.pdf  binary
